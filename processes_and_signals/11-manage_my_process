#!/usr/bin/env bash
# I hate bugs
DAEMON="./manage_my_process"
PIDFILE="/var/run/my_process.pid"

case "$1" in
    start)
        # start the daemon in background
        $DAEMON &
        echo $! > "$PIDFILE"
        echo "manage_my_process started"
        ;;
    stop)
        if [ -f "$PIDFILE" ]; then
            pid="$(cat "$PIDFILE")"
            if [ -n "$pid" ]; then
                kill "$pid" 2>/dev/null
            fi
            rm -f "$PIDFILE"
        fi
        echo "manage_my_process stopped"
        ;;
    restart)
        # stop
        if [ -f "$PIDFILE" ]; then
            pid="$(cat "$PIDFILE")"
            if [ -n "$pid" ]; then
                kill "$pid" 2>/dev/null
            fi
            rm -f "$PIDFILE"
        fi
        # start
        $DAEMON &
        echo $! > "$PIDFILE"
        echo "manage_my_process restarted"
        ;;
    *)
        echo "Usage: manage_my_process {start|stop|restart}"
        ;;
esac
